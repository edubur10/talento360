
# Proxy inverso para Talento 360 Salud
# Acceso mediante IP privada y certificado interno.

:443 {
    encode zstd gzip

    @publico path /c/* /api/public/* /seguimiento
    log_skip @publico

    log {
        output stdout
        format json
    }

    header {
        -Server
    }

    reverse_proxy app:3000
}