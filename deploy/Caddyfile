
# Proxy inverso para Talento 360 Salud
# Acceso mediante IP privada y certificado interno.

http://{$DOMAIN} {
    tls internal

    encode zstd gzip

    @publico path /c/* /api/public/* /seguimiento
    log_skip @publico

    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    reverse_proxy app:3000
}
