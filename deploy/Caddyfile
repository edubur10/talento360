{
    admin off
}

# Proxy inverso para Talento 360 Salud en HTTP plano
{$DOMAIN}:3002 {
    encode zstd gzip

    @publico path /c/* /api/public/* /seguimiento*
    log_skip @publico

    log {
        output stdout
        format json
    }

    header {
        -Server
    }

    reverse_proxy app:3000
}